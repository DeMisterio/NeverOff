    <!-- Passphrase-protected backup of the identity key. Wording here is
         deliberately blunt about the irreversibility: this is the one screen
         where an unclear warning costs somebody their entire history. -->
    <string name="backup_title">Chat backup</string>
    <string name="backup_subtitle_off">Your messages can only be read on this device</string>
    <string name="backup_subtitle_on">Backed up %1$s</string>
    <string name="backup_explain">Your messages are encrypted with a key that exists only on this phone. If you uninstall the app or lose the device, they cannot be recovered — not by you, not by us.\n\nSet a recovery passphrase and that key is stored, sealed with it, so you can restore your history on a new device.</string>
    <string name="backup_warning">We never see your passphrase and cannot reset it. If you forget it, your history is gone permanently.</string>
