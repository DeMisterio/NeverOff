<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) backup/transfer policy.

  allowBackup="false" in the manifest already blocks cloud backup and `adb backup`, but on
  API 31+ device-to-device transfer is governed separately by this file. Both sections are
  therefore excluded outright: the local store holds the SQLCipher database and
  neveroff_crypto_prefs, which wraps the identity keypair. None of it should leave the
  device through a channel the app does not control.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
